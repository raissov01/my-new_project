# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/frontend/.next/
/frontend/out/
/backend/.next/

# production
/build
/frontend/build
/backend/bin
/backend/.cache

# compiled Go binaries in backend root
/backend/telegram-auth
/backend/telegram-import
/backend/pdf-flashcards
/backend/pdf-extract
/backend/server

# local Docker overrides
/docker/docker-compose.override.yml
/docker/nginx.local.conf

# misc
.DS_Store
*.pem
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!/frontend/.env.example
!/backend/.env.example

# pm2
pm2-*.log

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA service worker build artifacts (regenerated by next build)
/frontend/public/sw.js
/frontend/public/workbox-*.js

/src/generated/prisma
/frontend/src/generated/prisma
