PORT=5000
ENVIRONMENT=development

# PostgreSQL (docker-compose overrides this with the container URL)
DATABASE_URL=postgres://studywithraissov:changeme@localhost:5432/studywithraissov?sslmode=disable

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Internal bridge token (Next.js → Go server-to-server calls)
CORS_ORIGINS=http://localhost:3000
BACKEND_INTERNAL_TOKEN=replace-with-a-long-random-secret

# AI (at least one required for document import)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-5.3
CLAUDE_API_KEY=

CLAUDE_MODEL=anthropic-claude-opus-4.6
CLAUDE_FALLBACK_MODEL=anthropic-claude-sonnet-4.6
CLAUDE_API_URL=https://inference.do-ai.run/v1/chat/completions
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90

GEMINI_MODEL=gemini-2.5-flash
AI_MAX_UPLOAD_MB=20

# Azure OpenAI for NUET PDF extraction.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Optional: set separate deployments/prices for -model=pro and -model=flash.
AZURE_OPENAI_DEPLOYMENT_PRO=
AZURE_OPENAI_DEPLOYMENT_FLASH=
AZURE_OPENAI_INPUT_PER_M=0.15
AZURE_OPENAI_OUTPUT_PER_M=0.60

# Transactional email (Resend HTTP API — replaces SMTP).
# Get an API key at https://resend.com — free tier: 3000 emails/month.
# RESEND_FROM must use a verified domain (or onboarding@resend.dev for testing).
RESEND_API_KEY=
RESEND_FROM=StudyWithRaissov <noreply@studywithraissov.com>
