PORT=5000
ENVIRONMENT=development

# PostgreSQL (docker-compose overrides this with the container URL)
DATABASE_URL=postgres://studywithraissov:changeme@localhost:5432/studywithraissov?sslmode=disable

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Internal bridge token (Next.js → Go server-to-server calls)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_INTERNAL_TOKEN=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5000/api/v1/auth/google/callback

# AI (at least one required for document import)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_UPLOAD_MB=20
