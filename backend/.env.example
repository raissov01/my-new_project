PORT=5000
ENVIRONMENT=development

# PostgreSQL (docker-compose overrides this with the container URL)
DATABASE_URL=postgres://studywithraissov:changeme@localhost:5432/studywithraissov?sslmode=disable

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Internal bridge token (Next.js → Go server-to-server calls)
CORS_ORIGINS=http://localhost:3000
BACKEND_INTERNAL_TOKEN=replace-with-a-long-random-secret

# AI (at least one required for document import)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-5.3
CLAUDE_API_KEY=

CLAUDE_MODEL=anthropic-claude-opus-4.6
CLAUDE_FALLBACK_MODEL=anthropic-claude-sonnet-4.6
CLAUDE_API_URL=https://inference.do-ai.run/v1/chat/completions
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=90

GEMINI_MODEL=gemini-2.5-flash
AI_MAX_UPLOAD_MB=20
